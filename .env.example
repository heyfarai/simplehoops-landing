POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=do-not-reply@shuuk.ca
OPS_EMAIL=farai@shuuk.ca

# Cloudflare Turnstile — form spam protection.
# Add a site at https://dash.cloudflare.com → Turnstile.
# Required in production; if unset in dev/test, verification is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local dev only — uncomment to use Mailpit instead of Postmark
# USE_MAILPIT=true
# MAILPIT_SMTP_HOST=localhost
# MAILPIT_SMTP_PORT=1025
